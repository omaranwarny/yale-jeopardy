# Copy to .env and fill in. Never commit .env.
# The app looks for .env here first, then in the folder ABOVE this repo.
# Use either key (if both are set, Portkey is used):
#   PORTKEY_API_KEY  course key  -> Portkey gateway, model gpt-6-luna
#   OPENAI_API_KEY   your own    -> OpenAI directly, model gpt-5.6-luna (change with LLM_MODEL)
PORTKEY_API_KEY=
OPENAI_API_KEY=
# Optional (defaults shown)
# LLM_MODEL=gpt-6-luna            # or any model your account can use
# LLM_BASE_URL=https://api.portkey.ai/v1
# DAILY_BUDGET_USD=1.00          # hard daily cap for the whole server; then the AIs play offline
# NEW_GAMES_PER_HOUR=20          # per device
# CUSTOM_BOARDS_PER_HOUR=4       # per device
